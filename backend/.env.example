# URL de conexión a PostgreSQL, usada por el paquete "database" (Prisma).
# En Render se configura con la Internal Database URL del servicio PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/iatech"

# Render asigna PORT automáticamente; 3000 se usa para desarrollo local.
PORT=3000
# Usa un valor aleatorio de al menos 32 caracteres. Nunca subas el valor real.
AUTH_SECRET="CHANGE_ME"
# En producción usa la URL pública del frontend desplegado en Vercel.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Dominios propios para subdominios de área. Ejemplo local: seguridad.localhost.
TENANT_ROOT_DOMAINS="localhost"
# Hosts del API compartido autorizados. En Render añade el hostname del servicio.
API_HOSTNAMES="localhost,127.0.0.1"
# true exige subdominio para inventarios; el login central sigue disponible.
# false permite una sola sede web con rutas /dashboard/:area.
TENANT_REQUIRE_SUBDOMAIN=true
# Ejecutar database/security/schema-roles.sql antes de habilitar la API.
DB_SCHEMA_ROLES=true
FEATURE_SECURITY_ACTIVITY=false
