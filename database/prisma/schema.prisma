// database/prisma/schema.prisma
// IATECH Co. - Diseno de base de datos de activos por area
// Prisma ORM v7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "core", "seguridad", "software", "bigdata", "calidad", "redes"]
  // La URL de conexion ya NO va aqui en Prisma 7.
  // Vive en prisma.config.ts (ver ese archivo).
}

// ---------------------------------------------------------
// CATEGORIA - una fila por cada area de la empresa
// ---------------------------------------------------------
model Categoria {
  id_categoria     Int    @id @default(autoincrement())
  nombre_categoria String @unique @db.VarChar(50)

  activos  Activo[]
  usuarios Usuario[]

  @@map("categoria")
  @@schema("core")
}

// ---------------------------------------------------------
// ACTIVO - tabla base, campos comunes a todas las areas
// ---------------------------------------------------------
model Activo {
  id_activo      Int       @id @default(autoincrement())
  codigo         String    @unique @db.VarChar(20)
  descripcion    String    @db.VarChar(255)
  id_categoria   Int
  categoria      Categoria @relation(fields: [id_categoria], references: [id_categoria])
  fecha_registro DateTime  @default(now()) @db.Date
  estado         String    @default("ACTIVO") @db.VarChar(20)

  hardware  Hardware?
  software  Software?
  redes     Redes?
  seguridad Seguridad?
  calidad   Calidad?
  cloud     Cloud?
  bigdata   BigData?

  @@map("activo")
  @@schema("public")
}

// ---------------------------------------------------------
// Tablas de detalle por area (1 a 1 con ACTIVO)
// onDelete: Cascade -> al borrar el ACTIVO, se borra su detalle solo
// ---------------------------------------------------------
model Hardware {
  id_activo    Int     @id
  activo       Activo  @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  numero_serie String  @db.VarChar(50)
  modelo       String? @db.VarChar(50)
  marca        String? @db.VarChar(50)

  @@map("hardware")
  @@schema("public")
}

model Software {
  id_activo        Int       @id
  activo           Activo    @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  version          String?   @db.VarChar(20)
  tipo_licencia    String?   @db.VarChar(50)
  fecha_expiracion DateTime? @db.Date

  @@map("software")
  @@schema("public")
}

model Redes {
  id_activo     Int     @id
  activo        Activo  @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  direccion_ip  String? @db.VarChar(45)
  tipo_conexion String? @db.VarChar(50)
  ancho_banda   String? @db.VarChar(30)

  @@map("redes")
  @@schema("public")
}

model Seguridad {
  id_activo      Int     @id
  activo         Activo  @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  tipo_seguridad String? @db.VarChar(50)
  nivel_acceso   String? @db.VarChar(30)
  protocolo      String? @db.VarChar(50)

  @@map("seguridad")
  @@schema("public")
}

model Calidad {
  id_activo       Int       @id
  activo          Activo    @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  norma_iso       String?   @db.VarChar(30)
  certificacion   String?   @db.VarChar(50)
  fecha_auditoria DateTime? @db.Date

  @@map("calidad")
  @@schema("public")
}

model Cloud {
  id_activo     Int     @id
  activo        Activo  @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  proveedor     String? @db.VarChar(50)
  tipo_servicio String? @db.VarChar(50)
  capacidad     String? @db.VarChar(30)

  @@map("cloud")
  @@schema("public")
}

model BigData {
  id_activo     Int     @id
  activo        Activo  @relation(fields: [id_activo], references: [id_activo], onDelete: Cascade)
  herramienta   String? @db.VarChar(50)
  tipo_dato     String? @db.VarChar(50)
  volumen_datos String? @db.VarChar(30)

  @@map("big_data_analiticas")
  @@schema("public")
}

// ---------------------------------------------------------
// USUARIO - login por area
// ---------------------------------------------------------
model Usuario {
  id_usuario      Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(100)
  correo          String    @unique @db.VarChar(100)
  contrasena_hash String    @db.VarChar(255)
  id_categoria    Int
  categoria       Categoria @relation(fields: [id_categoria], references: [id_categoria])
  rol             String    @default("USUARIO") @db.VarChar(20)
  estado          String    @default("ACTIVO") @db.VarChar(20)
  fecha_creacion  DateTime  @default(now())

  @@map("usuario")
  @@schema("core")
}

// Registro de accesos: nunca almacena contraseñas ni tokens.
model EventoAcceso {
  id        Int      @id @default(autoincrement())
  correo    String   @db.VarChar(254)
  ip        String   @db.VarChar(45)
  resultado String   @db.VarChar(10)
  fecha     DateTime @default(now()) @db.Timestamptz(3)

  @@index([fecha, id])
  @@index([resultado, fecha, correo])
  @@map("evento_acceso")
  @@schema("core")
}

model RecursoSeguridad {
  id_activo             Int       @id @default(autoincrement())
  nombre                String?   @db.VarChar(150)
  categoria_recurso     String?   @db.VarChar(50)
  funcion_seguridad     String?   @db.VarChar(50)
  responsable           String?   @db.VarChar(100)
  criticidad            String?   @db.VarChar(10)
  estado_gestion        String?   @db.VarChar(20)
  fecha_ultima_revision DateTime? @db.Date
  resultado_revision    String?   @db.VarChar(30)
  fecha_creacion        DateTime  @default(now()) @db.Timestamp(3)
  fecha_modificacion    DateTime  @default(now()) @db.Timestamp(3)

  @@map("recursos_seguridad")
  @@schema("seguridad")
}

model HerramientaDesarrollo {
  id_herramienta_dev         Int       @id @default(autoincrement())
  nombre_herramienta         String    @db.VarChar(100)
  categoria_dev              String    @db.VarChar(50)
  estado_funcionamiento      String    @default("Activa") @db.VarChar(20)
  version_aprobada           String    @db.VarChar(30)
  fecha_ultima_actualizacion DateTime? @db.Date
  tipo_licencia              String    @db.VarChar(50)
  costo_total_usd            Decimal?  @default(0.00) @db.Decimal(10, 2)
  fecha_adquisicion          DateTime  @db.Date
  fecha_expiracion           DateTime? @db.Date

  @@map("herramientas_desarrollo")
  @@schema("software")
}

model ActivoDatos {
  id_activo                  Int       @id @default(autoincrement())
  nombre_activo              String?   @db.VarChar(150)
  fecha_creacion             DateTime? @db.Date
  fecha_modificacion         DateTime? @db.Date
  tipo_activo                String?   @db.VarChar(30)
  fuente_origen              String?   @db.VarChar(100)
  clasificacion_sensibilidad String?   @db.VarChar(20)
  responsable_owner          String?   @db.VarChar(100)
  ubicacion_repositorio      String?   @db.VarChar(200)
  estado                     String?   @db.VarChar(20)

  @@map("activos_datos")
  @@schema("bigdata")
}

model HerramientaCalidad {
  id_herramienta        Int       @id @default(autoincrement())
  nombre_herramienta    String?   @db.VarChar(150)
  categoria_herramienta String?   @db.VarChar(50)
  responsable           String?   @db.VarChar(100)
  criticidad            String?   @db.VarChar(10)
  estado_gestion        String?   @db.VarChar(20)
  fecha_ultima_revision DateTime? @db.Date
  resultado_revision    String?   @db.VarChar(30)
  fecha_creacion        DateTime  @default(now()) @db.Timestamp(3)
  fecha_modificacion    DateTime  @default(now()) @db.Timestamp(3)

  @@map("herramientas_calidad")
  @@schema("calidad")
}

model DispositivoRed {
  id_dispositivo         Int     @id @default(autoincrement())
  nombre_dispositivo     String? @db.VarChar(100)
  modelo                 String? @db.VarChar(100)
  area_pertenencia       String? @db.VarChar(100)
  direccion_ip           String? @db.VarChar(45)
  red_pertenencia        String? @db.VarChar(100)
  marca                  String? @db.VarChar(50)
  protocolo_enrutamiento String? @db.VarChar(30)
  tipo_dispositivo       String? @db.VarChar(30)
  estado                 String? @db.VarChar(20)

  @@map("dispositivos_red")
  @@schema("redes")
}
