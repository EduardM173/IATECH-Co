// database/prisma/schema.prisma
// IATECH Co. - Inventario unificado y aislado por area
// Prisma ORM v7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // La URL de conexion ya NO va aqui en Prisma 7.
  // Vive en prisma.config.ts (ver ese archivo).
}

// ---------------------------------------------------------
// CATEGORIA - una fila por cada area de la empresa
// ---------------------------------------------------------
model Categoria {
  id_categoria     Int    @id @default(autoincrement())
  nombre_categoria String @unique @db.VarChar(50)

  inventario Inventario[]
  usuarios   Usuario[]

  @@map("categoria")
}

// ---------------------------------------------------------
// INVENTARIO - una tabla compartida; id_categoria aisla cada area.
// Los campos propios de cada area son opcionales a nivel Prisma. La migracion
// agrega un trigger de PostgreSQL que exige y valida los que correspondan.
// ---------------------------------------------------------
model Inventario {
  id_inventario      Int       @id @default(autoincrement())
  id_categoria       Int
  categoria          Categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Restrict, onUpdate: Cascade)
  nombre             String    @db.VarChar(150)
  responsable        String?   @db.VarChar(100)
  estado             String    @db.VarChar(20)
  fecha_creacion     DateTime  @default(now()) @db.Timestamptz(3)
  fecha_modificacion DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  // Hardware y dispositivos de red
  tipo_equipo            String?   @db.VarChar(30)
  marca                  String?   @db.VarChar(50)
  modelo                 String?   @db.VarChar(100)
  numero_serie           String?   @db.VarChar(100)
  departamento           String?   @db.VarChar(100)
  ubicacion_fisica       String?   @db.VarChar(150)
  fecha_adquisicion      DateTime? @db.Date
  fecha_fin_garantia     DateTime? @db.Date
  direccion_ip           String?   @db.VarChar(45)
  red_pertenencia        String?   @db.VarChar(100)
  protocolo_enrutamiento String?   @db.VarChar(30)
  tipo_dispositivo       String?   @db.VarChar(30)

  // Software / herramientas de desarrollo
  categoria_item             String?   @db.VarChar(50)
  version_aprobada           String?   @db.VarChar(30)
  fecha_ultima_actualizacion DateTime? @db.Date
  tipo_licencia              String?   @db.VarChar(50)
  costo_total_usd            Decimal?  @default(0) @db.Decimal(10, 2)
  fecha_expiracion           DateTime? @db.Date

  // Calidad y Seguridad
  criticidad            String?   @db.VarChar(10)
  funcion_seguridad     String?   @db.VarChar(50)
  fecha_ultima_revision DateTime? @db.Date
  resultado_revision    String?   @db.VarChar(30)

  // Big Data y Analitica
  tipo_activo                String? @db.VarChar(30)
  fuente_origen              String? @db.VarChar(100)
  clasificacion_sensibilidad String? @db.VarChar(20)
  ubicacion_repositorio      String? @db.VarChar(200)

  // Cloud
  proveedor             String?  @db.VarChar(50)
  tipo_servicio         String?  @db.VarChar(100)
  identificador_recurso String?  @db.VarChar(512)
  cuenta_proyecto       String?  @db.VarChar(100)
  region                String?  @db.VarChar(50)
  entorno               String?  @db.VarChar(20)
  costo_mensual_usd     Decimal? @db.Decimal(10, 2)

  @@index([id_categoria, estado])
  @@index([id_categoria, fecha_modificacion, id_inventario])
  @@map("inventario")
}

// ---------------------------------------------------------
// USUARIO - login por area
// ---------------------------------------------------------
model Usuario {
  id_usuario      Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(100)
  correo          String    @unique @db.VarChar(100)
  contrasena_hash String    @db.VarChar(255)
  id_categoria    Int
  categoria       Categoria @relation(fields: [id_categoria], references: [id_categoria])
  rol             String    @default("USUARIO") @db.VarChar(20)
  estado          String    @default("ACTIVO") @db.VarChar(20)
  fecha_creacion  DateTime  @default(now())

  @@index([id_categoria])
  @@map("usuario")
}

// Registro de accesos: nunca almacena contraseñas ni tokens.
model EventoAcceso {
  id        Int      @id @default(autoincrement())
  correo    String   @db.VarChar(254)
  ip        String   @db.VarChar(45)
  resultado String   @db.VarChar(10)
  fecha     DateTime @default(now()) @db.Timestamptz(3)

  @@index([fecha, id])
  @@index([resultado, fecha, correo])
  @@map("evento_acceso")
}
