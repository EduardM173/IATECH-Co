# Dirección del backend que consume Vite. Esta variable se expone al navegador,
# por lo que debe contener únicamente una URL pública, nunca secretos.
# /api usa el proxy de Vite o Vercel y permite cookies del mismo sitio.
VITE_API_URL="/api"
# En producción sustituir por un dominio propio realmente configurado.
# Dejar vacío si se usa el dominio compartido durante la transición.
VITE_TENANT_ROOT_DOMAIN="localhost"
VITE_CENTRAL_ORIGIN="http://localhost:5173"
VITE_FEATURE_SECURITY_ACTIVITY=false
